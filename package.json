{
  "name": "alexa-finances",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prisma:generate": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "start:discloud": "npm run prisma:generate && NODE_ENV=production PORT=${PORT:-8080} HOST=${HOST:-0.0.0.0} node --import tsx apps/api/src/server.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@alexa-finances/database": "file:packages/database",
    "@alexa-finances/market-data": "file:packages/market-data",
    "@alexa-finances/portfolio-domain": "file:packages/portfolio-domain",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  }
}
