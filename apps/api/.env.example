DATABASE_URL="file:./alexa-finances.db"
LOG_LEVEL="info"
# For Turso production, set both values below. DATABASE_URL remains for local development.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
API_BEARER_TOKEN="replace-with-a-random-token-of-at-least-32-characters"
MARKET_SCHEDULER_ENABLED=false
# Optional: comma-separated B3/Tesouro non-trading dates, e.g. 2026-12-25,2027-01-01.
MARKET_HOLIDAY_DATES=""
# Required for automatic stock and FII quotes. Keep this secret out of git.
BRAPI_API_KEY=""
# Optional until a Treasury position exists; it must return the documented normalized JSON contract.
MARKET_TESOURO_EOD_URL=""
PORT=3000
HOST=127.0.0.1
