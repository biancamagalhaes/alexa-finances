{
  "type": "APL",
  "version": "2024.3",
  "theme": "dark",
  "mainTemplate": {
    "parameters": ["portfolio"],
    "items": [
      {
        "type": "Container",
        "id": "screen",
        "width": "100vw",
        "height": "100vh",
        "paddingLeft": "5vw",
        "paddingRight": "5vw",
        "paddingTop": "4vh",
        "paddingBottom": "3vh",
        "backgroundColor": "#101827",
        "bind": [{ "name": "showValues", "value": false }],
        "items": [
          {
            "type": "Container",
            "direction": "row",
            "justifyContent": "spaceBetween",
            "items": [
              {
                "type": "Text",
                "text": "Minha Carteira",
                "style": "textStylePrimary1",
                "color": "#F8FAFC"
              },
              {
                "type": "Text",
                "text": "Atualizado ${portfolio.asOfLabel}",
                "style": "textStyleSecondary",
                "color": "#94A3B8"
              }
            ]
          },
          {
            "type": "Container",
            "direction": "row",
            "spacing": "12dp",
            "paddingTop": "20dp",
            "items": [
              {
                "type": "TouchWrapper",
                "onPress": [{ "type": "SendEvent", "arguments": ["select-profile", "bianca"] }],
                "item": { "type": "Text", "text": "Bianca", "paddingLeft": "18dp", "paddingRight": "18dp", "paddingTop": "10dp", "paddingBottom": "10dp", "borderRadius": "20dp", "backgroundColor": "${portfolio.profile.id == 'bianca' ? '#2563EB' : '#1E293B'}", "color": "#F8FAFC" }
              },
              {
                "type": "TouchWrapper",
                "onPress": [{ "type": "SendEvent", "arguments": ["select-profile", "sergio"] }],
                "item": { "type": "Text", "text": "Sergio", "paddingLeft": "18dp", "paddingRight": "18dp", "paddingTop": "10dp", "paddingBottom": "10dp", "borderRadius": "20dp", "backgroundColor": "${portfolio.profile.id == 'sergio' ? '#2563EB' : '#1E293B'}", "color": "#F8FAFC" }
              },
              {
                "type": "TouchWrapper",
                "onPress": [{ "type": "SendEvent", "arguments": ["select-profile", "family"] }],
                "item": { "type": "Text", "text": "Família", "paddingLeft": "18dp", "paddingRight": "18dp", "paddingTop": "10dp", "paddingBottom": "10dp", "borderRadius": "20dp", "backgroundColor": "${portfolio.profile.id == 'family' ? '#2563EB' : '#1E293B'}", "color": "#F8FAFC" }
              }
            ]
          },
          {
            "type": "Container",
            "direction": "row",
            "justifyContent": "spaceBetween",
            "paddingTop": "32dp",
            "items": [
              {
                "type": "Container",
                "items": [
                  { "type": "Text", "text": "Patrimônio", "style": "textStyleSecondary", "color": "#94A3B8" },
                  { "type": "Text", "text": "${showValues ? portfolio.summary.patrimony : portfolio.summary.maskedPatrimony}", "style": "textStylePrimary2", "color": "#F8FAFC" }
                ]
              },
              {
                "type": "TouchWrapper",
                "onPress": [{ "type": "SetValue", "componentId": "screen", "property": "showValues", "value": "${!showValues}" }],
                "item": { "type": "Text", "text": "${showValues ? '◉ Ocultar' : '◉ Mostrar'}", "paddingLeft": "18dp", "paddingRight": "18dp", "paddingTop": "12dp", "paddingBottom": "12dp", "borderRadius": "20dp", "backgroundColor": "#1E293B", "color": "#E2E8F0" }
              }
            ]
          },
          {
            "type": "Container",
            "direction": "row",
            "spacing": "20dp",
            "paddingTop": "28dp",
            "items": [
              {
                "type": "Container",
                "width": "30%",
                "backgroundColor": "#172033",
                "padding": "18dp",
                "borderRadius": "14dp",
                "items": [
                  { "type": "Text", "text": "Resultado no mês", "style": "textStyleSecondary", "color": "#94A3B8" },
                  { "type": "Text", "text": "${showValues ? portfolio.summary.monthlyResult : portfolio.summary.maskedMonthlyResult}", "style": "textStylePrimary2", "color": "#F8FAFC" },
                  { "type": "Text", "text": "${portfolio.resultLabel}", "style": "textStyleSecondary", "color": "#94A3B8" }
                ]
              },
              {
                "type": "Container",
                "width": "30%",
                "backgroundColor": "#172033",
                "padding": "18dp",
                "borderRadius": "14dp",
                "items": [
                  { "type": "Text", "text": "Aportado", "style": "textStyleSecondary", "color": "#94A3B8" },
                  { "type": "Text", "text": "${showValues ? portfolio.summary.contributions : portfolio.summary.maskedContributions}", "style": "textStylePrimary2", "color": "#F8FAFC" }
                ]
              },
              {
                "type": "Container",
                "width": "30%",
                "backgroundColor": "#172033",
                "padding": "18dp",
                "borderRadius": "14dp",
                "items": [
                  { "type": "Text", "text": "Proventos", "style": "textStyleSecondary", "color": "#94A3B8" },
                  { "type": "Text", "text": "${showValues ? portfolio.summary.income : portfolio.summary.maskedIncome}", "style": "textStylePrimary2", "color": "#F8FAFC" }
                ]
              }
            ]
          },
          {
            "type": "Container",
            "direction": "row",
            "spacing": "28dp",
            "paddingTop": "30dp",
            "items": [
              {
                "type": "Container",
                "width": "42%",
                "items": [
                  { "type": "Text", "text": "Distribuição", "style": "textStylePrimary2", "color": "#F8FAFC" },
                  {
                    "type": "Container",
                    "data": "${portfolio.allocation}",
                    "items": [
                      { "type": "Text", "text": "${data.label} · ${data.percentageLabel}", "paddingTop": "10dp", "style": "textStylePrimary3", "color": "#CBD5E1" }
                    ]
                  }
                ]
              },
              {
                "type": "Container",
                "width": "54%",
                "items": [
                  { "type": "Text", "text": "Posições", "style": "textStylePrimary2", "color": "#F8FAFC" },
                  {
                    "type": "Sequence",
                    "height": "28vh",
                    "data": "${portfolio.positions}",
                    "numbered": false,
                    "items": [
                      {
                        "type": "Container",
                        "direction": "row",
                        "justifyContent": "spaceBetween",
                        "paddingTop": "10dp",
                        "paddingBottom": "10dp",
                        "items": [
                          { "type": "Text", "text": "${data.symbol} · ${data.classLabel}", "color": "#E2E8F0", "style": "textStylePrimary3" },
                          { "type": "Text", "text": "${showValues ? data.value : data.maskedValue}", "color": "#E2E8F0", "style": "textStylePrimary3" }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
