PORTFOLIO_API_BASE_URL=https://api.example.com
PORTFOLIO_API_TOKEN=replace-with-service-token

# Data Store publisher. Keep dry-run locally and in tests; only set live in the
# protected backend scheduler environment.
ALEXA_DATA_STORE_MODE=dry-run
ALEXA_DATA_STORE_ENDPOINT=https://api.amazonalexa.com
LWA_TOKEN_ENDPOINT=https://api.amazon.com/auth/O2/token
LWA_CLIENT_ID=replace-with-lwa-client-id
LWA_CLIENT_SECRET=replace-with-lwa-client-secret
ALEXA_DATA_STORE_TARGET_TYPE=DEVICES
# Capture this skill-scoped value from the UsagesInstalled lifecycle request.
ALEXA_DATA_STORE_DEVICE_IDS=amzn1.ask.device.replace-with-echo-show-15-id
ALEXA_DATA_STORE_ATTEMPT_DELIVERY_MINUTES=60
# Set to true only while copying the skill-scoped device ID from the first
# UsagesInstalled Lambda log into protected backend configuration, then disable.
ALEXA_WIDGET_ASSOCIATION_LOG_ENABLED=false
