{
  "type": "APL",
  "version": "2024.3",
  "theme": "dark",
  "extensions": [
    { "name": "DataStore", "uri": "alexaext:datastore:10" }
  ],
  "settings": {
    "DataStore": {
      "dataBindings": [
        {
          "namespace": "portfolio",
          "key": "summary",
          "dataBindingName": "DS_Portfolio",
          "dataType": "OBJECT"
        }
      ]
    }
  },
  "mainTemplate": {
    "parameters": ["payload"],
    "items": [
      {
        "type": "Container",
        "id": "widget-root",
        "width": "100vw",
        "height": "100vh",
        "paddingLeft": "22dp",
        "paddingRight": "22dp",
        "paddingTop": "18dp",
        "paddingBottom": "18dp",
        "backgroundColor": "#101827",
        "bind": [
          { "name": "showValues", "value": false },
          { "name": "portfolio", "value": "${DS_Portfolio ? DS_Portfolio : payload.portfolio}" }
        ],
        "items": [
          {
            "type": "Container",
            "direction": "row",
            "justifyContent": "spaceBetween",
            "items": [
              { "type": "Text", "text": "Minha Carteira", "style": "textStylePrimary2", "color": "#F8FAFC" },
              {
                "type": "TouchWrapper",
                "onPress": [{ "type": "SetValue", "componentId": "widget-root", "property": "showValues", "value": "${!showValues}" }],
                "item": { "type": "Text", "text": "${showValues ? '◉' : '⊘'}", "fontSize": "28dp", "color": "#CBD5E1" }
              }
            ]
          },
          {
            "type": "Container",
            "direction": "row",
            "spacing": "8dp",
            "paddingTop": "12dp",
            "items": [
              { "type": "TouchWrapper", "onPress": [{ "type": "SendEvent", "arguments": ["select-profile", "bianca"], "flags": { "interactionMode": "STANDARD" } }], "item": { "type": "Text", "text": "Bianca", "paddingLeft": "10dp", "paddingRight": "10dp", "paddingTop": "6dp", "paddingBottom": "6dp", "backgroundColor": "${portfolio.profile.id == 'bianca' ? '#2563EB' : '#1E293B'}", "color": "#F8FAFC" } },
              { "type": "TouchWrapper", "onPress": [{ "type": "SendEvent", "arguments": ["select-profile", "sergio"], "flags": { "interactionMode": "STANDARD" } }], "item": { "type": "Text", "text": "Sergio", "paddingLeft": "10dp", "paddingRight": "10dp", "paddingTop": "6dp", "paddingBottom": "6dp", "backgroundColor": "${portfolio.profile.id == 'sergio' ? '#2563EB' : '#1E293B'}", "color": "#F8FAFC" } },
              { "type": "TouchWrapper", "onPress": [{ "type": "SendEvent", "arguments": ["select-profile", "family"], "flags": { "interactionMode": "STANDARD" } }], "item": { "type": "Text", "text": "Família", "paddingLeft": "10dp", "paddingRight": "10dp", "paddingTop": "6dp", "paddingBottom": "6dp", "backgroundColor": "${portfolio.profile.id == 'family' ? '#2563EB' : '#1E293B'}", "color": "#F8FAFC" } }
            ]
          },
          {
            "type": "Container",
            "paddingTop": "20dp",
            "items": [
              { "type": "Text", "text": "Patrimônio", "style": "textStyleSecondary", "color": "#94A3B8" },
              { "type": "Text", "text": "${showValues ? portfolio.summary.patrimony : portfolio.summary.maskedPatrimony}", "style": "textStylePrimary1", "color": "#F8FAFC" },
              { "type": "Text", "text": "${portfolio.asOfLabel}", "style": "textStyleSecondary", "color": "#94A3B8" }
            ]
          },
          {
            "type": "Container",
            "direction": "row",
            "spacing": "12dp",
            "paddingTop": "16dp",
            "items": [
              { "type": "Container", "width": "50%", "backgroundColor": "#172033", "padding": "12dp", "borderRadius": "12dp", "items": [{ "type": "Text", "text": "Resultado no mês", "style": "textStyleSecondary", "color": "#94A3B8" }, { "type": "Text", "text": "${showValues ? portfolio.summary.monthlyResult : portfolio.summary.maskedMonthlyResult}", "style": "textStylePrimary3", "color": "#F8FAFC" }] },
              { "type": "Container", "width": "50%", "backgroundColor": "#172033", "padding": "12dp", "borderRadius": "12dp", "items": [{ "type": "Text", "text": "Proventos", "style": "textStyleSecondary", "color": "#94A3B8" }, { "type": "Text", "text": "${showValues ? portfolio.summary.income : portfolio.summary.maskedIncome}", "style": "textStylePrimary3", "color": "#F8FAFC" }] }
            ]
          },
          {
            "type": "TouchWrapper",
            "paddingTop": "16dp",
            "onPress": [{ "type": "SendEvent", "arguments": ["show-details", "${portfolio.profile.id}"], "flags": { "interactionMode": "STANDARD" } }],
            "item": { "type": "Text", "text": "Abrir painel completo ›", "color": "#93C5FD", "style": "textStylePrimary3" }
          }
        ]
      }
    ]
  }
}
